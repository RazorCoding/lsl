// NIS (NVIDIA Image Scaling) sharpening -- the 1:1 pass lsl's `nis` method runs
// after FSR1's EASU upscale.
//
// Ported from NVIDIA's MIT-licensed NIS_Scaler.h (NVSharpen, GetDirUSM,
// GetEdgeMap, CalcLTIFast, EvalUSM).  NVIDIA's shader loads its 5x5 support
// through a linear-clamp sampler at a coordinate that lands exactly on a texel
// centre, so on this storage-buffer engine the taps are plain clamped integer
// fetches and the port is faithful rather than approximate.  The USM profile
// and the luma ramps are separate constants from NVSharpenUpdateConfig(),
// taken at the sharpness slider's neutral 0.5 -- see src/nis_ref.cpp, which
// carries the same numbers and is compared against this shader by every
// `lsl-upscale --modes nis`.
//
// Compiled twice: RGBA8 I/O by default, half-float with -DLSL_IO_16F, exactly
// like shaders/scale.comp.  This file has no mode selector; it is one pass.

#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform PC {
    uint  srcW, srcH, dstW, dstH;
    uint  mode;        // unused here
    float sharpness;   // unused here
    uint  pad0, pad1;
} p;

#ifdef LSL_IO_16F

layout(set = 0, binding = 0, std430) readonly  buffer Src { uint src[]; } s_src;
layout(set = 0, binding = 1, std430) writeonly buffer Dst { uint dst[]; } s_dst;

uint ioIndex(uint x, uint y, uint w) { return 2u * (y * w + x); }
uint outIndex(uint x, uint y, uint w) { return 2u * (y * w + x); }

vec3 fetch(int x, int y)
{
    x = clamp(x, 0, int(p.srcW) - 1);
    y = clamp(y, 0, int(p.srcH) - 1);
    const uint i = ioIndex(uint(x), uint(y), p.srcW);
    return vec3(unpackHalf2x16(s_src.src[i]),
                unpackHalf2x16(s_src.src[i + 1u]).x) * 255.0;
}

float fetch01(int x, int y, int c)
{
    x = clamp(x, 0, int(p.srcW) - 1);
    y = clamp(y, 0, int(p.srcH) - 1);
    const uint i = ioIndex(uint(x), uint(y), p.srcW);
    const vec2 lo = unpackHalf2x16(s_src.src[i]);
    const vec2 hi = unpackHalf2x16(s_src.src[i + 1u]);
    const float v = (c == 0) ? lo.x : ((c == 1) ? lo.y : hi.x);
    return clamp(v, 0.0, 1.0);
}

void storePixel(uint i, vec3 v)
{
    const vec3 n = clamp(v, 0.0, 255.0) * (1.0 / 255.0);
    s_dst.dst[i]      = packHalf2x16(n.rg);
    s_dst.dst[i + 1u] = packHalf2x16(vec2(n.b, 1.0));
}

#else

layout(set = 0, binding = 0, std430) readonly  buffer Src { uint src[]; } s_src;
layout(set = 0, binding = 1, std430) writeonly buffer Dst { uint dst[]; } s_dst;

uint ioIndex(uint x, uint y, uint w) { return y * w + x; }
uint outIndex(uint x, uint y, uint w) { return y * w + x; }

vec3 fetch(int x, int y)
{
    x = clamp(x, 0, int(p.srcW) - 1);
    y = clamp(y, 0, int(p.srcH) - 1);
    uint packed = s_src.src[ioIndex(uint(x), uint(y), p.srcW)];
    return vec3(float(packed & 0xffu),
                float((packed >> 8) & 0xffu),
                float((packed >> 16) & 0xffu));
}

float fetch01(int x, int y, int c)
{
    x = clamp(x, 0, int(p.srcW) - 1);
    y = clamp(y, 0, int(p.srcH) - 1);
    uint packed = s_src.src[ioIndex(uint(x), uint(y), p.srcW)];
    return float((packed >> uint(8 * c)) & 0xffu) * (1.0 / 255.0);
}

uint pack(vec3 v)
{
    uvec3 c = clamp(uvec3(round(v)), uvec3(0u), uvec3(255u));
    return c.r | (c.g << 8) | (c.b << 16) | 0xff000000u;
}

void storePixel(uint i, vec3 v) { s_dst.dst[i] = pack(v); }

#endif

// NVSharpenUpdateConfig(sharpness = 0.5), SDR.  Same values as src/nis_ref.cpp.
const float kEps                = 1.0 / 255.0;
const float kDetectRatio        = 2.0 * 1127.0 / 1024.0;
const float kDetectThres        = 64.0 / 1024.0;
const float kMinContrastRatio   = 2.0;
const float kRatioNorm          = 1.0 / 8.0;
const float kContrastBoost      = 1.0;
const float kSharpStartY        = 0.45;
const float kSharpScaleY        = 1.0 / 0.45;
const float kSharpStrengthMin   = 0.4;
const float kSharpStrengthScale = 1.2;
const float kSharpLimitMin      = 0.14;
const float kSharpLimitScale    = 0.36;

float nisSat(float x) { return clamp(x, 0.0, 1.0); }

// CalcLTIFast: damps the USM where the neighbourhood is already a hard edge.
float calcLTI(float y[5])
{
    const float a_min = min(min(y[0], y[1]), y[2]);
    const float a_max = max(max(y[0], y[1]), y[2]);
    const float b_min = min(min(y[2], y[3]), y[4]);
    const float b_max = max(max(y[2], y[3]), y[4]);
    const float a_cont = a_max - a_min;
    const float b_cont = b_max - b_min;
    const float cont_ratio = max(a_cont, b_cont) / (min(a_cont, b_cont) + kEps);
    return (1.0 - nisSat((cont_ratio - kMinContrastRatio) * kRatioNorm)) * kContrastBoost;
}

float evalUSM(float pxl[5], float strength, float limit)
{
    float y_usm = -0.6001 * pxl[1] + 1.2002 * pxl[2] - 0.6001 * pxl[3];
    y_usm *= strength;
    y_usm = min(limit, max(-limit, y_usm));
    y_usm *= calcLTI(pxl);
    return y_usm;
}

// Returns (0deg, 90deg, 45deg, 135deg), matching NVIDIA's rval.xyzw.
vec4 dirUSM(float p[5][5])
{
    const float scaleY = 1.0 - nisSat((p[2][2] - kSharpStartY) * kSharpScaleY);
    const float strength = scaleY * kSharpStrengthScale + kSharpStrengthMin;
    const float limit = (scaleY * kSharpLimitScale + kSharpLimitMin) * p[2][2];

    float d0[5], d90[5], d45[5], d135[5];
    for (int i = 0; i < 5; ++i) { d0[i] = p[i][2]; d90[i] = p[2][i]; }

    d45[0] = p[1][1];
    d45[1] = mix(p[2][1], p[1][2], 0.5);
    d45[2] = p[2][2];
    d45[3] = mix(p[3][2], p[2][3], 0.5);
    d45[4] = p[3][3];

    d135[0] = p[3][1];
    d135[1] = mix(p[3][2], p[2][1], 0.5);
    d135[2] = p[2][2];
    d135[3] = mix(p[2][3], p[1][2], 0.5);
    d135[4] = p[1][3];

    return vec4(evalUSM(d0, strength, limit),
                evalUSM(d90, strength, limit),
                evalUSM(d45, strength, limit),
                evalUSM(d135, strength, limit));
}

// Returns (weight_0, weight_90, weight_45, weight_135), as NVIDIA orders them.
vec4 edgeMap(float p[5][5], int i, int j)
{
    const float g_0 = abs(p[i + 0][j + 0] + p[i + 0][j + 1] + p[i + 0][j + 2]
                        - p[i + 2][j + 0] - p[i + 2][j + 1] - p[i + 2][j + 2]);
    const float g_45 = abs(p[i + 1][j + 0] + p[i + 0][j + 0] + p[i + 0][j + 1]
                         - p[i + 2][j + 1] - p[i + 2][j + 2] - p[i + 1][j + 2]);
    const float g_90 = abs(p[i + 0][j + 0] + p[i + 1][j + 0] + p[i + 2][j + 0]
                         - p[i + 0][j + 2] - p[i + 1][j + 2] - p[i + 2][j + 2]);
    const float g_135 = abs(p[i + 1][j + 0] + p[i + 2][j + 0] + p[i + 2][j + 1]
                          - p[i + 0][j + 1] - p[i + 0][j + 2] - p[i + 1][j + 2]);

    const float g_0_90_max = max(g_0, g_90);
    const float g_0_90_min = min(g_0, g_90);
    const float g_45_135_max = max(g_45, g_135);
    const float g_45_135_min = min(g_45, g_135);

    if (g_0_90_max + g_45_135_max == 0.0) return vec4(0.0);

    const float e_0_90 = min(g_0_90_max / (g_0_90_max + g_45_135_max), 1.0);
    const float e_45_135 = 1.0 - e_0_90;

    const bool c_0_90 = (g_0_90_max > (g_0_90_min * kDetectRatio)) &&
                        (g_0_90_max > kDetectThres) && (g_0_90_max > g_45_135_min);
    const bool c_45_135 = (g_45_135_max > (g_45_135_min * kDetectRatio)) &&
                          (g_45_135_max > kDetectThres) && (g_45_135_max > g_0_90_min);
    const bool c_g_0_90 = (g_0_90_max == g_0);
    const bool c_g_45_135 = (g_45_135_max == g_45);

    const float f_e_0_90 = (c_0_90 && c_45_135) ? e_0_90 : 1.0;
    const float f_e_45_135 = (c_0_90 && c_45_135) ? e_45_135 : 1.0;

    // .x = 0deg, .y = 90deg, .z = 45deg, .w = 135deg
    return vec4((c_0_90 && c_g_0_90) ? f_e_0_90 : 0.0,
                (c_0_90 && !c_g_0_90) ? f_e_0_90 : 0.0,
                (c_45_135 && c_g_45_135) ? f_e_45_135 : 0.0,
                (c_45_135 && !c_g_45_135) ? f_e_45_135 : 0.0);
}

void main()
{
    const uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= p.dstW || gid.y >= p.dstH) return;

    const int x = int(gid.x), y = int(gid.y);

    float pp[5][5];
    for (int i = 0; i < 5; ++i)
        for (int j = 0; j < 5; ++j)
            pp[i][j] = 0.2126 * fetch01(x + j - 2, y + i - 2, 0) +
                       0.7152 * fetch01(x + j - 2, y + i - 2, 1) +
                       0.0722 * fetch01(x + j - 2, y + i - 2, 2);

    const vec4 d = dirUSM(pp);
    const vec4 w = edgeMap(pp, 1, 1);
    const float usmY = dot(d, w);

    vec3 op = fetch(x, y) + usmY * 255.0;
    storePixel(ioIndex(uint(x), uint(y), p.dstW), op);
}
